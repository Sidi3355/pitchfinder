{
  "name": "pitchfinder",
  "private": true,
  "version": "0.1.0",
  "description": "PitchFinder: where to play football in London, ranked for your whole group.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check . && npm run check:copy",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "audit:data": "node scripts/audit-data.mjs",
    "check": "npm run lint && npm run test && npm run build:test && npm run check:bundle && npm run test:e2e && npm run lighthouse",
    "check:copy": "node scripts/check-copy.mjs",
    "serve": "node scripts/serve.mjs",
    "build:test": "vite build --mode test && node scripts/prerender.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "maplibre-gl": "^6.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  }
}
